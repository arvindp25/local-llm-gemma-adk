# Local Gemma Environment Configuration
OLLAMA_API_BASE=http://127.0.0.1:11434
PRIMARY_MODEL=gemma4:e4b
FALLBACK_MODEL=gemma2:9b
EMBEDDING_MODEL=nomic-embed-text
PROVIDER_TYPE=adk_litellm

# Context limits (8GB VRAM RTX 5050 safeguard)
NUM_CTX=8192
MAX_TOKENS=2048
TEMPERATURE=0.7

# Ollama engine parameters
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Vector Database (Qdrant / Chroma)
VECTOR_DB_TYPE=qdrant
QDRANT_PATH=.data/qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agent_persistent_knowledge
